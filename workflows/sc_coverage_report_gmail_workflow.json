      "id": "29105ed3-8de1-44c1-b98d-b93076d3f026",
      "name": "Report Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -500,
        20
      ]
    },
    {
      "parameters": {
        "command": "={{ 'cd \"' + $json.projectPath + '\" && venv/bin/python scripts/run_report_for_n8n.py --banner \"' + $json.banner + '\" --seasons ' + $json.seasons.map(season => '\"' + season + '\"').join(' ') + ' --order-type \"' + $json.orderType + '\" --dashboard-url \"' + $json.dashboardUrl + '\" --recipient-name \"' + $json.recipientName + '\"' }}"
      },
      "id": "9fab8dca-0892-47ca-b23f-eafc1208b054",
      "name": "Run Report Agent",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -240,
        20
      ]
    },
    {
      "parameters": {
        "jsCode": "const stdout = $json.stdout || '';\nconst stderr = $json.stderr || '';\nconst lines = stdout.trim().split(/\\r?\\n/).filter(Boolean);\nconst jsonLine = lines[lines.length - 1] || '{}';\n\nlet payload;\ntry {\n  payload = JSON.parse(jsonLine);\n} catch (error) {\n  payload = {\n    status: 'failed',\n    error: `Could not parse report runner JSON: ${error.message}`,\n    raw_stdout: stdout,\n    raw_stderr: stderr,\n    email_subject: 'SC Coverage Report Failed',\n    email_body: `The SC Coverage Report workflow failed before it could parse report output.\\n\\nSTDOUT:\\n${stdout}\\n\\nSTDERR:\\n${stderr}`,\n  };\n}\n\nreturn [{ json: payload }];"
      },
      "id": "d53c3b7e-dc32-4999-aaf6-9e8809a1fb3c",
      "name": "Parse Report JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        20
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "status-success",
              "leftValue": "={{ $json.status }}",
              "rightValue": "success",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "validation-passed",
              "leftValue": "={{ $json.validation_passed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0f06d914-8973-4e6d-8d85-e86f06cf3c04",
      "name": "Report Successful?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        280,
        20
      ]
    },
    {
